# ==============================================================================
# Omnichannel AI Chatbot Environment Variables Configuration Template
# Copy this file to `.env` and fill in the values for your environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# WhatsApp Cloud API Settings
# ------------------------------------------------------------------------------
# The Phone Number ID provided by Meta Developer Portal for WhatsApp Cloud API.
WHATSAPP_PHONE_NUMBER_ID=""

# The Permanent or Temporary Access Token generated on Meta Developer Portal.
WHATSAPP_ACCESS_TOKEN=""

# The App Secret of your Meta App (used for validating webhook payloads signature).
WHATSAPP_APP_SECRET=""

# A custom token you define to verify the webhook ownership handshake with Meta.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""

# WhatsApp Graph API Version (defaults to v18.0).
WHATSAPP_API_VERSION="v18.0"


# ------------------------------------------------------------------------------
# Telegram Bot API Settings
# ------------------------------------------------------------------------------
# The API Token given by Telegram's @BotFather.
TELEGRAM_BOT_TOKEN=""

# A secure random secret token used to verify that webhook calls come from Telegram.
# Can generate one using: python generate-telegram-secret.py
TELEGRAM_SECRET_TOKEN=""

# The public facing URL of your application (e.g. from ngrok, cloudflare tunnel).
# Required to automatically register the webhook endpoint with Telegram.
NGROK_URL=""


# ------------------------------------------------------------------------------
# LLM Providers Configuration
# ------------------------------------------------------------------------------
# Google Gemini API Key (Required for general tasks & embeddings).
GEMINI_API_KEY=""

# OpenRouter API Key (Alternative/fallback LLM endpoint).
OPENROUTER_API_KEY=""

# The primary model to use via OpenRouter.
OPENROUTER_PRIMARY_MODEL="openrouter/owl-alpha"

# Comma-separated list of fallback models to use if the primary model fails.
OPENROUTER_FALLBACK_MODELS="openai/gpt-oss-120b:free,z-ai/glm-4.5-air:free"


# ------------------------------------------------------------------------------
# Django ERP Integration Settings
# ------------------------------------------------------------------------------
# The URL of the central Django ERP system (defaults to http://localhost:8000).
ERP_BASE_URL="http://localhost:8000"

# Username and password for authentication against the ERP API.
ERP_USERNAME=""
ERP_PASSWORD=""

# Database URL for direct access to ERP tables/checkpointers.
# E.g., postgresql://user:pass@host:port/dbname
ERP_DB_URL=""

# Database URL for vector embeddings & similarity search (if separate from ERP DB).
# Defaults to ERP_DB_URL if left blank.
VECTOR_DB_URL=""


# ------------------------------------------------------------------------------
# Redis Settings
# ------------------------------------------------------------------------------
# Redis server hostname (use "redis" if running in docker-compose, or "localhost").
REDIS_HOST="localhost"

# Redis server port (defaults to 6379).
REDIS_PORT=6379
